# Local development defaults. On Railway, do not set HTTP_ADDR (PORT is injected).
HTTP_ADDR=:8080
# Required in production: generate with `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
# Required: local PostgreSQL or Railway Postgres reference variable.
DATABASE_URL=postgres://localhost:5432/bible?sslmode=disable
# Comma-separated origins, or * to allow any origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
